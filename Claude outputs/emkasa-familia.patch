+import "server-only";
+import { createClient } from "@/lib/supabase/server";
+import type { Diet } from "./schemas";
+
+export type HouseholdMember = {
+  id: string;
+  name: string;
+  relation: string | null;
+  birth_year: number | null;
+  diet: Diet;
+  allergies: string[];
+  likes: string[];
+  dislikes: string[];
+  goal: string | null;
+};
+
+export type Household = {
+  members: HouseholdMember[];
+  healthConsent: boolean;
+  allergens: { code: string; name: string }[];
+};
+
+/** Família da conta logada. O RLS só devolve as linhas do próprio dono. */
+export async function getHousehold(): Promise<Household> {
+  const supabase = await createClient();
+  const [members, consent, allergens] = await Promise.all([
+    supabase
+      .from("household_members")
+      .select(
+        "id, name, relation, birth_year, diet, allergies, likes, dislikes, goal",
+      )
+      .order("created_at", { ascending: true }),
+    supabase
+      .from("consents")
+      .select("id")
+      .eq("kind", "health_profile")
+      .is("revoked_at", null)
+      .limit(1),
+    supabase.from("allergens").select("code, name").order("name"),
+  ]);
+  if (members.error) {
+    console.error("[familia] leitura falhou:", members.error.message);
+  }
+  return {
+    members: (members.data ?? []) as HouseholdMember[],
+    healthConsent: (consent.data ?? []).length > 0,
+    allergens: allergens.data ?? [],
+  };
+}
diff --git a/src/modules/familia/schemas.ts b/src/modules/familia/schemas.ts
new file mode 100644
index 0000000..53b1a60
--- /dev/null
+++ b/src/modules/familia/schemas.ts
@@ -0,0 +1,78 @@
+import { z } from "zod";
+
+export const DIETS = {
+  sem_restricao: "Sem restrição",
+  vegetariano: "Vegetariana",
+  vegano: "Vegana",
+  sem_gluten: "Sem glúten",
+  sem_lactose: "Sem lactose",
+} as const;
+export type Diet = keyof typeof DIETS;
+
+/** Texto exato do consentimento de saúde. Vai gravado junto com o aceite. */
+export const HEALTH_CONSENT_TEXT =
+  "Autorizo a Emkasa a guardar as alergias, a dieta e o objetivo alimentar das pessoas da minha casa, inclusive crianças pelas quais sou responsável, só para filtrar e sugerir produtos. Posso retirar esta autorização e apagar esses dados quando quiser.";
+
+/** "banana, jiló ,  " -> ["banana", "jiló"] (sem repetidos, no máximo 20). */
+export function parseList(raw: string): string[] {
+  const seen = new Set<string>();
+  for (const part of raw.split(/[,;\n]/)) {
+    const item = part.trim().replace(/\s+/g, " ");
+    if (item) seen.add(item.slice(0, 40));
+    if (seen.size >= 20) break;
+  }
+  return [...seen];
+}
+
+export const memberSchema = z.object({
+  id: z.uuid().optional(),
+  name: z
+    .string()
+    .trim()
+    .min(1, "Informe o nome ou apelido.")
+    .max(40, "Nome muito longo."),
+  relation: z
+    .string()
+    .trim()
+    .max(30, "Texto muito longo.")
+    .transform((v) => (v === "" ? null : v)),
+  birthYear: z
+    .string()
+    .trim()
+    .refine(
+      (v) => v === "" || /^\d{4}$/.test(v),
+      "Informe o ano com 4 números.",
+    )
+    .transform((v) => (v === "" ? null : Number(v)))
+    .refine(
+      (v) => v === null || (v >= 1900 && v <= new Date().getFullYear()),
+      "Confira o ano de nascimento.",
+    ),
+  diet: z.enum(Object.keys(DIETS) as [Diet, ...Diet[]]),
+  allergies: z.array(z.string().regex(/^[a-z0-9_]+$/)).max(30),
+  likes: z.string().max(900).transform(parseList),
+  dislikes: z.string().max(900).transform(parseList),
+  goal: z
+    .string()
+    .trim()
+    .max(160, "Use até 160 letras.")
+    .transform((v) => (v === "" ? null : v)),
+});
+export type MemberInput = z.infer<typeof memberSchema>;
+
+/** Esta pessoa tem algum dado de saúde preenchido? */
+export function hasHealthData(
+  m: Pick<MemberInput, "allergies" | "diet" | "goal">,
+) {
+  return (
+    m.allergies.length > 0 || m.diet !== "sem_restricao" || m.goal !== null
+  );
+}
+
+/** Idade aproximada a partir do ano de nascimento. */
+export function ageFrom(
+  birthYear: number | null,
+  now = new Date(),
+): number | null {
+  return birthYear === null ? null : Math.max(0, now.getFullYear() - birthYear);
+}
diff --git a/supabase/migrations/20261116001000_household.sql b/supabase/migrations/20261116001000_household.sql
new file mode 100644
index 0000000..7c9e9fe
--- /dev/null
+++ b/supabase/migrations/20261116001000_household.sql
@@ -0,0 +1,139 @@
+-- =============================================================================
+-- Emkasa Gourmet — Migration 0010: família da conta (D-043)
+-- Cada pessoa da casa, com o que come, o que evita e o que não pode.
+-- Alergia, dieta e objetivo são dado de saúde (LGPD art. 11): só entram com
+-- consentimento registrado, e SÓ O DONO DA CONTA lê. Nem a administração vê.
+-- =============================================================================
+
+-- Registro de consentimentos da conta (texto aceito, quando, e se foi retirado).
+create table public.consents (
+  id          uuid primary key default gen_random_uuid(),
+  customer_id uuid not null default auth.uid() references public.customers (id) on delete cascade,
+  kind        text not null check (kind in ('health_profile')),
+  consent_text text not null check (char_length(consent_text) between 20 and 600),
+  granted_at  timestamptz not null default now(),
+  revoked_at  timestamptz
+);
+create index consents_customer_idx on public.consents (customer_id, kind);
+
+create table public.household_members (
+  id          uuid primary key default gen_random_uuid(),
+  customer_id uuid not null default auth.uid() references public.customers (id) on delete cascade,
+  name        text not null check (char_length(name) between 1 and 40),
+  -- Quem é na família: "filho", "mãe", "eu". Texto livre e curto.
+  relation    text check (relation is null or char_length(relation) <= 30),
+  -- Ano de nascimento em vez de idade: a idade muda sozinha.
+  birth_year  smallint check (birth_year is null or birth_year between 1900 and 2100),
+  diet        text not null default 'sem_restricao'
+              check (diet in ('sem_restricao', 'vegano', 'vegetariano', 'sem_gluten', 'sem_lactose')),
+  -- Códigos da tabela allergens (conferidos por trigger).
+  allergies   text[] not null default '{}',
+  likes       text[] not null default '{}',
+  dislikes    text[] not null default '{}',
+  goal        text check (goal is null or char_length(goal) <= 160),
+  created_at  timestamptz not null default now(),
+  updated_at  timestamptz not null default now(),
+  check (cardinality(allergies) <= 30),
+  check (cardinality(likes) <= 20),
+  check (cardinality(dislikes) <= 20)
+);
+create index household_members_customer_idx on public.household_members (customer_id);
+
+create trigger household_members_set_updated_at
+  before update on public.household_members
+  for each row execute function public.set_updated_at();
+
+-- Consentimento de saúde em vigor para a conta?
+create or replace function public.has_health_consent(p_customer uuid)
+returns boolean
+language sql
+stable
+set search_path = ''
+as $$
+  select exists (
+    select 1 from public.consents c
+     where c.customer_id = p_customer and c.kind = 'health_profile' and c.revoked_at is null
+  );
+$$;
+
+-- Regras da pessoa da casa: alergênico tem de existir; dado de saúde exige
+-- consentimento; textos livres curtos; no máximo 12 pessoas por conta.
+create or replace function public.household_members_check()
+returns trigger
+language plpgsql
+set search_path = ''
+as $$
+declare
+  v_bad text;
+begin
+  if tg_op = 'INSERT' and (
+    select count(*) from public.household_members m where m.customer_id = new.customer_id
+  ) >= 12 then
+    raise exception 'Limite de 12 pessoas por conta.' using errcode = 'check_violation';
+  end if;
+
+  select a into v_bad from unnest(new.allergies) a
+   where not exists (select 1 from public.allergens g where g.code = a) limit 1;
+  if v_bad is not null then
+    raise exception 'Alergênico desconhecido: %', v_bad using errcode = 'check_violation';
+  end if;
+
+  if exists (select 1 from unnest(new.likes || new.dislikes) t where char_length(t) not between 1 and 40) then
+    raise exception 'Cada item de gosto precisa ter de 1 a 40 letras.' using errcode = 'check_violation';
+  end if;
+
+  if (cardinality(new.allergies) > 0 or new.diet <> 'sem_restricao' or new.goal is not null)
+     and not public.has_health_consent(new.customer_id) then
+    raise exception 'Falta o consentimento para guardar dados de saúde.' using errcode = 'check_violation';
+  end if;
+  return new;
+end;
+$$;
+create trigger household_members_check
+  before insert or update on public.household_members
+  for each row execute function public.household_members_check();
+
+-- Retirar o consentimento apaga os dados de saúde de todos da casa, na hora.
+create or replace function public.revoke_health_consent()
+returns void
+language plpgsql
+set search_path = ''
+as $$
+begin
+  update public.household_members
+     set allergies = '{}', diet = 'sem_restricao', goal = null
+   where customer_id = (select auth.uid());
+  update public.consents
+     set revoked_at = now()
+   where customer_id = (select auth.uid()) and kind = 'health_profile' and revoked_at is null;
+end;
+$$;
+
+alter table public.consents          enable row level security;
+alter table public.household_members enable row level security;
+
+-- Dono da conta e mais ninguém. Não existe regra de leitura para a equipe.
+create policy "consents: só o dono lê"
+  on public.consents for select to authenticated
+  using (customer_id = (select auth.uid()));
+create policy "consents: só o dono registra"
+  on public.consents for insert to authenticated
+  with check (customer_id = (select auth.uid()));
+create policy "consents: só o dono retira"
+  on public.consents for update to authenticated
+  using (customer_id = (select auth.uid()))
+  with check (customer_id = (select auth.uid()));
+
+create policy "household_members: só o dono"
+  on public.household_members for all to authenticated
+  using (customer_id = (select auth.uid()))
+  with check (customer_id = (select auth.uid()));
+
+revoke all on public.consents, public.household_members from public, anon, authenticated;
+grant select on public.consents to authenticated;
+grant insert (kind, consent_text) on public.consents to authenticated;
+grant update (revoked_at) on public.consents to authenticated;
+grant select, insert, update, delete on public.household_members to authenticated;
+revoke execute on function public.revoke_health_consent() from public, anon;
+grant execute on function public.revoke_health_consent() to authenticated;
+grant execute on function public.has_health_consent(uuid) to authenticated;
diff --git a/tests/db/household.test.ts b/tests/db/household.test.ts
new file mode 100644
index 0000000..9852483
--- /dev/null
+++ b/tests/db/household.test.ts
@@ -0,0 +1,161 @@
+import type { PGlite } from "@electric-sql/pglite";
+import { beforeAll, describe, expect, it } from "vitest";
+import { as, createTestDb, createUser } from "./harness";
+
+const ANA = "00000000-0000-0000-0000-0000000000e1";
+const BIA = "00000000-0000-0000-0000-0000000000e2";
+const OWNER = "00000000-0000-0000-0000-0000000000e3";
+const TEXT =
+  "Autorizo a Emkasa a guardar alergias, dieta e objetivos das pessoas da minha casa.";
+let db: PGlite;
+
+type Who = { userId: string } | { anon: true };
+const run = (who: Who, sql: string, params: unknown[] = []) =>
+  as(db, who, async () => (await db.query(sql, params)).rows);
+const consent = (userId: string) =>
+  run(
+    { userId },
+    "insert into public.consents (kind, consent_text) values ('health_profile', $1)",
+    [TEXT],
+  );
+
+beforeAll(async () => {
+  db = await createTestDb();
+  await createUser(db, ANA);
+  await createUser(db, BIA);
+  await createUser(db, OWNER, "owner");
+  for (const id of [ANA, BIA, OWNER]) {
+    await run(
+      { userId: id },
+      "insert into public.customers (id, name, email) values ($1, 'Cliente', 'x@x.com')",
+      [id],
+    );
+  }
+});
+
+describe("família da conta", () => {
+  it("pessoa sem dado de saúde entra sem consentimento", async () => {
+    await run(
+      { userId: ANA },
+      "insert into public.household_members (name, relation, likes, dislikes) values ('Léo', 'filho', '{banana}', '{jiló}')",
+    );
+    expect(
+      await run({ userId: ANA }, "select name from public.household_members"),
+    ).toEqual([{ name: "Léo" }]);
+  });
+
+  it("alergia, dieta ou objetivo exigem consentimento registrado", async () => {
+    for (const set of [
+      "allergies = '{leite}'",
+      "diet = 'vegano'",
+      "goal = 'comer mais verduras'",
+    ]) {
+      await expect(
+        run({ userId: ANA }, `update public.household_members set ${set}`),
+      ).rejects.toThrow(/consentimento/);
+    }
+    await consent(ANA);
+    await run(
+      { userId: ANA },
+      "update public.household_members set allergies = '{leite,soja}', diet = 'vegetariano'",
+    );
+    const rows = await run(
+      { userId: ANA },
+      "select allergies, diet from public.household_members",
+    );
+    expect(rows).toEqual([
+      { allergies: ["leite", "soja"], diet: "vegetariano" },
+    ]);
+  });
+
+  it("recusa alergênico que não existe na lista oficial", async () => {
+    await expect(
+      run(
+        { userId: ANA },
+        "update public.household_members set allergies = '{kriptonita}'",
+      ),
+    ).rejects.toThrow(/desconhecido/);
+  });
+
+  it("só o dono lê: outra cliente, a administração e o visitante não veem nada", async () => {
+    expect(
+      await run({ userId: BIA }, "select id from public.household_members"),
+    ).toHaveLength(0);
+    expect(
+      await run({ userId: OWNER }, "select id from public.household_members"),
+    ).toHaveLength(0);
+    expect(
+      await run({ userId: OWNER }, "select id from public.consents"),
+    ).toHaveLength(0);
+    await expect(
+      run({ anon: true }, "select id from public.household_members"),
+    ).rejects.toThrow();
+  });
+
+  it("ninguém cadastra, altera ou apaga pessoa na conta de outra", async () => {
+    await expect(
+      run(
+        { userId: BIA },
+        "insert into public.household_members (customer_id, name) values ($1, 'Intrusa')",
+        [ANA],
+      ),
+    ).rejects.toThrow();
+    await run(
+      { userId: BIA },
+      "update public.household_members set name = 'Trocado'",
+    );
+    await run({ userId: BIA }, "delete from public.household_members");
+    expect(
+      await run({ userId: ANA }, "select name from public.household_members"),
+    ).toEqual([{ name: "Léo" }]);
+  });
+
+  it("retirar o consentimento apaga os dados de saúde e mantém a pessoa", async () => {
+    await run({ userId: ANA }, "select public.revoke_health_consent()");
+    const rows = await run(
+      { userId: ANA },
+      "select name, allergies, diet, goal, dislikes from public.household_members",
+    );
+    expect(rows).toEqual([
+      {
+        name: "Léo",
+        allergies: [],
+        diet: "sem_restricao",
+        goal: null,
+        dislikes: ["jiló"],
+      },
+    ]);
+    await expect(
+      run(
+        { userId: ANA },
+        "update public.household_members set diet = 'vegano'",
+      ),
+    ).rejects.toThrow(/consentimento/);
+  });
+
+  it("o consentimento de uma conta não vale para outra", async () => {
+    await consent(BIA);
+    await expect(
+      run(
+        { userId: ANA },
+        "update public.household_members set diet = 'vegano'",
+      ),
+    ).rejects.toThrow(/consentimento/);
+  });
+
+  it("limita a 12 pessoas por conta", async () => {
+    for (let i = 0; i < 11; i++) {
+      await run(
+        { userId: ANA },
+        "insert into public.household_members (name) values ($1)",
+        [`Pessoa ${i}`],
+      );
+    }
+    await expect(
+      run(
+        { userId: ANA },
+        "insert into public.household_members (name) values ('Treze')",
+      ),
+    ).rejects.toThrow(/Limite/);
+  });
+});
diff --git a/tests/unit/familia.test.ts b/tests/unit/familia.test.ts
new file mode 100644
index 0000000..c81d43c
--- /dev/null
+++ b/tests/unit/familia.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from "vitest";
+import {
+  ageFrom,
+  hasHealthData,
+  memberSchema,
+  parseList,
+} from "@/modules/familia/schemas";
+
+const ok = {
+  name: " Léo ",
+  relation: "filho",
+  birthYear: "2018",
+  diet: "sem_restricao",
+  allergies: [],
+  likes: "banana, abóbora,banana ,, ",
+  dislikes: "",
+  goal: "",
+};
+
+describe("pessoa da casa", () => {
+  it("limpa textos e transforma listas", () => {
+    expect(memberSchema.parse(ok)).toMatchObject({
+      name: "Léo",
+      birthYear: 2018,
+      likes: ["banana", "abóbora"],
+      dislikes: [],
+      goal: null,
+    });
+  });
+  it("ano de nascimento é opcional, mas tem de ser um ano de verdade", () => {
+    expect(memberSchema.parse({ ...ok, birthYear: "" }).birthYear).toBeNull();
+    expect(memberSchema.safeParse({ ...ok, birthYear: "18" }).success).toBe(
+      false,
+    );
+    expect(memberSchema.safeParse({ ...ok, birthYear: "2999" }).success).toBe(
+      false,
+    );
+  });
+  it("recusa dieta fora da lista e código de alergênico estranho", () => {
+    expect(memberSchema.safeParse({ ...ok, diet: "carnivora" }).success).toBe(
+      false,
+    );
+    expect(
+      memberSchema.safeParse({ ...ok, allergies: ["DROP TABLE"] }).success,
+    ).toBe(false);
+  });
+  it("sabe quando há dado de saúde", () => {
+    const base = memberSchema.parse(ok);
+    expect(hasHealthData(base)).toBe(false);
+    expect(hasHealthData({ ...base, allergies: ["leite"] })).toBe(true);
+    expect(hasHealthData({ ...base, diet: "vegano" })).toBe(true);
+    expect(hasHealthData({ ...base, goal: "menos açúcar" })).toBe(true);
+  });
+  it("corta listas longas e itens grandes", () => {
+    expect(
+      parseList(Array.from({ length: 30 }, (_, i) => `item ${i}`).join(",")),
+    ).toHaveLength(20);
+    expect(parseList("x".repeat(80))[0]).toHaveLength(40);
+  });
+  it("calcula a idade pelo ano", () => {
+    expect(ageFrom(2018, new Date("2026-11-16"))).toBe(8);
+    expect(ageFrom(null)).toBeNull();
+  });
+});
